{
  "expo": {
    "name": "Vote2",
    "slug": "Vote2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "voteapp",

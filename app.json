{
  "expo": {
    "name": "Vote2",
    "slug": "Vote2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "voteapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "hideExponentText": true,
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beampie.voteapp",
      "associatedDomains": [
        "applinks:api-voteapp.beampie.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.beampie.voteapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2efe4161-8ac7-48c1-babd-ac31ce5fb1eb"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
